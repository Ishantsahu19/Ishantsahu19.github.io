# Normalize line endings so diffs stay clean across Windows and macOS/Linux
* text=auto eol=lf

*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.md   text eol=lf
*.svg  text eol=lf
*.json text eol=lf
*.yml  text eol=lf

# Never touch binaries
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
